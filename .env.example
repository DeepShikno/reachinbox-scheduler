PORT=4000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=reachinbox
DB_SSL=false            # set true for hosted MySQL (Aiven etc.)

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=         # hosted Redis only
REDIS_PASSWORD=         # hosted Redis only
REDIS_TLS=false         # set true if your host requires TLS

# Elasticsearch (local docker or Elastic Cloud)
ES_URL=http://127.0.0.1:9200
ES_API_KEY=

# Worker behaviour (no hardcoding)
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# TEMPORARY until Google login is added (Phase 3)
DEV_USER_ID=1

# Auth (Phase 3)
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
AUTH_DEV_BYPASS=false   # true = skip login and act as DEV_USER_ID (Postman only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Slack OAuth app (needs an https redirect URL, e.g. an ngrok tunnel to :4000)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://YOUR-TUNNEL.ngrok-free.app/api/slack/callback
